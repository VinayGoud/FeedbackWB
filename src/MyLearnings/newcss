.myLearnings {
  width: 100%;
  max-width: 360px;
  padding: 20px;
  box-sizing: border-box;
  font-family: inherit;
  color: #242424;
  background: #ffffff;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 18px;
}

.heading {
  margin: 0;
  color: #242424;
  font-size: 24px;
  font-weight: 600;
  line-height: 30px;
}

.headingLine {
  width: 40px;
  height: 3px;
  margin-left: 12px;
  background: #a6192e;
}

.learningCard {
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  background: #f7f7f7;
  border-radius: 8px;
}

.cardTitleRow {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 8px;
}

.trainingIcon {
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  margin-top: 1px;
  object-fit: contain;
}

.cardTitle {
  color: #242424;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.description {
  margin: 0 0 14px 32px;
  color: #424242;
  font-size: 13px;
  font-weight: 400;
  line-height: 19px;
}

.linkRow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20px;
  margin-left: 32px;
}

.actionLink {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #8b1e2d;
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  text-decoration: none;
  cursor: pointer;

  &:hover {
    color: #681621;
    text-decoration: underline;
  }

  &:focus-visible {
    outline: 2px solid #242424;
    outline-offset: 3px;
  }
}

.arrow {
  display: inline-block;
  font-size: 15px;
  font-weight: 400;
  line-height: 1;
}

.loading {
  padding: 16px;
  color: #424242;
  font-size: 14px;
  line-height: 20px;
}


/* Quick View */

.quickViewOverlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  justify-content: flex-end;
  background: rgba(0, 0, 0, 0.35);
}

.quickView {
  width: 420px;
  max-width: 100%;
  height: 100%;
  overflow-y: auto;
  background: #ffffff;
  box-shadow: -4px 0 16px rgba(0, 0, 0, 0.14);
}

.quickViewHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid #e1e1e1;
}

.quickViewTitle {
  color: #242424;
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}

.closeButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #242424;
  font-family: inherit;
  font-size: 24px;
  line-height: 32px;
  cursor: pointer;

  &:hover {
    background: #f5f5f5;
  }

  &:focus-visible {
    outline: 2px solid #242424;
    outline-offset: 2px;
  }
}

.quickViewContent {
  padding: 4px 24px 24px;
}

.trainingItem {
  padding: 20px 0;
  border-bottom: 1px solid #e1e1e1;

  &:last-child {
    border-bottom: 0;
  }
}

.courseTitleRow {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 8px;
}

.courseIcon {
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  margin-top: 1px;
  object-fit: contain;
}

.courseTitle {
  color: #242424;
  font-size: 15px;
  font-weight: 600;
  line-height: 21px;
}

.courseMessage {
  margin: 6px 0 8px 32px;
  color: #424242;
  font-size: 13px;
  line-height: 19px;
}

.dueDate,
.dueDatePassed {
  margin: 6px 0 12px 32px;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
}

.dueDate {
  color: #424242;
}

.dueDatePassed {
  color: #a4262c;
}

.courseLink {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-left: 32px;
  color: #8b1e2d;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  text-decoration: none;

  &:hover {
    color: #681621;
    text-decoration: underline;
  }

  &:focus-visible {
    outline: 2px solid #242424;
    outline-offset: 3px;
  }
}


@media (max-width: 480px) {

  .myLearnings {
    max-width: none;
    padding: 16px;
  }

  .heading {
    font-size: 22px;
    line-height: 28px;
  }

  .learningCard {
    padding: 14px;
  }

  .linkRow {
    gap: 14px;
  }

  .quickView {
    width: 100%;
  }
}
