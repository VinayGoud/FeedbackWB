.myLearnings {
  width: 100%;
  max-width: 360px;
  padding: 20px;
  box-sizing: border-box;
  font-family: inherit;
  color: #242424;
  background: #ffffff;
}


/* My Learning header */

.header {
  display: flex;
  align-items: center;
  margin-bottom: 18px;
}

.heading {
  margin: 0;
  color: #242424;
  font-size: 24px;
  font-weight: 600;
  line-height: 30px;
}

.headingLine {
  width: 40px;
  height: 3px;
  margin-left: 12px;
  background: #a6192e;
}


/* My Learning card */

.learningCard {
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  background: #f7f7f7;
  border-radius: 8px;
}

.cardTitleRow {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 8px;
}

.trainingIcon {
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  margin-top: 1px;
  object-fit: contain;
}

.cardTitle {
  color: #242424;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.description {
  margin: 0 0 14px 32px;
  color: #424242;
  font-size: 13px;
  font-weight: 400;
  line-height: 19px;
}


/* My Learning links */

.linkRow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20px;
  margin-left: 32px;
}

.actionLink {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #8b1e2d;
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  text-decoration: none;
  cursor: pointer;

  &:hover {
    color: #681621;
    text-decoration: underline;
  }

  &:focus-visible {
    outline: 2px solid #242424;
    outline-offset: 3px;
  }
}

.arrow {
  display: inline-block;
  font-size: 15px;
  font-weight: 400;
  line-height: 1;
}

.loading {
  padding: 16px;
  color: #424242;
  font-size: 14px;
  line-height: 20px;
}


/* =========================================================
   Training Quick View
   ========================================================= */

.trainingQuickView {
  :global(.ms-Callout-main) {
    width: 380px;
    max-width: 380px;
    max-height: 600px;
    overflow-y: auto;
    background: #ffffff;
  }
}

.quickViewContent {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
}


/* Quick View heading */

.quickViewHeading {
  padding: 20px 20px 0;
  color: #242424;
  font-size: 17px;
  font-weight: 600;
  line-height: 24px;
}

.quickViewDescription {
  padding: 8px 20px 18px;
  color: #424242;
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
}


/* Training list */

.quickViewItems {
  width: 100%;
}

.quickViewItem {
  padding: 16px 20px;
  box-sizing: border-box;
  background: #f3f2f1;
  border-top: 1px solid #edebe9;
}

.quickViewTrainingTitle {
  margin-bottom: 6px;
  color: #242424;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.quickViewMessage {
  margin-bottom: 12px;
  color: #424242;
  font-size: 12px;
  font-weight: 400;
  line-height: 18px;
}


/* Due date and Open button row */

.quickViewFooter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.quickViewDate {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 8px;
  color: #242424;
  font-size: 12px;
  font-weight: 400;
  line-height: 18px;
}

.quickViewDateAttention {
  color: #a4262c;
}

.quickViewDateIcon {
  width: 15px;
  height: 15px;
  flex: 0 0 15px;
  object-fit: contain;
}


/* Same purpose as Action.OpenUrl in existing Adaptive Card */

.quickViewOpenButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 72px;
  min-height: 32px;
  padding: 6px 14px;
  box-sizing: border-box;
  border: 0;
  background: #0078d4;
  color: #ffffff;
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  text-decoration: none;
  cursor: pointer;

  &:hover {
    background: #106ebe;
    color: #ffffff;
    text-decoration: none;
  }

  &:focus-visible {
    outline: 2px solid #242424;
    outline-offset: 2px;
  }
}


/* Responsive */

@media (max-width: 480px) {

  .myLearnings {
    max-width: none;
    padding: 16px;
  }

  .heading {
    font-size: 22px;
    line-height: 28px;
  }

  .learningCard {
    padding: 14px;
  }

  .linkRow {
    gap: 14px;
  }

  .trainingQuickView {
    :global(.ms-Callout-main) {
      width: 320px;
      max-width: calc(100vw - 24px);
    }
  }

  .quickViewFooter {
    align-items: flex-end;
  }
}
