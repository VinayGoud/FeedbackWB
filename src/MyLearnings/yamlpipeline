# azure-pipelines.yml
trigger:
  branches:
    include:
      - main

pool:
  vmImage: 'ubuntu-latest'

steps:
  - task: NodeTool@0
    inputs:
      versionSpec: '22.14.0'
    displayName: 'Use Node.js 22.14.0'

  - script: npm install
    displayName: 'npm install'

  - script: npx gulp clean
    displayName: 'gulp clean'

  - script: npx gulp build --ship
    displayName: 'gulp build --ship'

  - script: npx gulp bundle --ship
    displayName: 'gulp bundle --ship'

  - script: npx gulp package-solution --ship
    displayName: 'gulp package-solution --ship'

  - task: CopyFiles@2
    inputs:
      SourceFolder: 'sharepoint/solution'
      Contents: '**/*.sppkg'
      TargetFolder: '$(Build.ArtifactStagingDirectory)'
    displayName: 'Copy .sppkg to staging'

  - task: PublishBuildArtifacts@1
    inputs:
      PathtoPublish: '$(Build.ArtifactStagingDirectory)'
      ArtifactName: 'drop'
    displayName: 'Publish build artifacts'
